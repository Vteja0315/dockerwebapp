pipeline {
    agent any
    tools {
        maven "maven3"
    }
    environment {
        imagename = 'webappimg'
        dbimagename = 'dbimage'
    }
    stages {
        stage('Code') {
            steps {
                git 'https://github.com/Vteja0315/dockerwebapp.git'
            }
        }
        stage('Maven build') {
            steps {
                sh 'mvn clean install'
            }
        }
        stage('Image creation') {
            steps {
                sh '''
                cp -r target Docker-app/
                docker build -t $imagename Docker-app/
                docker build -t $dbimagename Docker-db/
                '''
            }
        }
        stage('CQA') {
            steps {
                withSonarQubeEnv(installationName: 'sonarqube',credentialsId: 'sonar') {
                    sh '''
                    mvn clean verify org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                    -Dsonar.projectKey=Myproject \
                    -Dsonar.projectName='Myproject' \
                    -Dsonar.host.url=http://44.246.247.46:9000 \
                    -Dsonar.token=sqp_7a9a4d7958d53654e2b06da6d825681a9e53f534
                    '''
                }
            }
        }
        stage('QualityGates'){
            steps{
                waitForQualityGate abortPipeline: true, credentialsId: 'sonar'
            }
        }
        stage('Containerization'){
            steps{
                sh 'docker-compose up -d'
            }
        }
    }
}
